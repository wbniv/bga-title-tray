{
  "manifest_version": 3,
  "name": "BGA title in tray",
  "description": "Show the selected Board Game Arena tab title or visible lobby state in the KDE panel and tray.",
  "version": "0.4.8",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "https://boardgamearena.com/*",
    "https://*.boardgamearena.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://boardgamearena.com/*", "https://*.boardgamearena.com/*"],
      "js": ["offer_state.js"],
      "run_at": "document_idle"
    }
  ]
}
