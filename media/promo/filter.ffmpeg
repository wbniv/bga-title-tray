[0:v]format=rgba,
drawbox=x=0:y=0:w=1280:h=12:color=0xb8ef00:t=fill,
drawbox=x=0:y=650:w=1280:h=1:color=0x56514b:t=fill,
drawbox=x=134:y=350:w=1012:h=166:color=0x171614:t=fill:enable='gte(t,3)',
drawbox=x=134:y=350:w=1012:h=2:color=0x77716a:t=fill:enable='gte(t,3)',
drawtext=fontfile=/usr/share/fonts/truetype/noto/NotoSans-Bold.ttf:text='INDRI':fontsize=30:fontcolor=0xb8ef00:x=90:y=52,
drawtext=fontfile=/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf:text='BOARD GAME ARENA TITLE TRAY':fontsize=21:fontcolor=0xc8c0b8:x=205:y=59,
drawtext=fontfile=/usr/share/fonts/truetype/noto/NotoSans-Bold.ttf:text='Never miss your next move.':fontsize=58:fontcolor=0xf5f0e8:x=90:y=222:enable='lt(t,3)',
drawtext=fontfile=/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf:text='A small KDE panel companion for BGA.':fontsize=30:fontcolor=0xc8c0b8:x=90:y=316:enable='lt(t,3)',
drawtext=fontfile=/usr/share/fonts/truetype/noto/NotoSans-Bold.ttf:text='Your game stays in sight.':fontsize=55:fontcolor=0xf5f0e8:x=90:y=185:enable='between(t,3,6)',
drawtext=fontfile=/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf:text='Illustrative countdown; no tab watching needed.':fontsize=28:fontcolor=0xc8c0b8:x=90:y=275:enable='between(t,3,6)',
drawtext=fontfile=/usr/share/fonts/truetype/noto/NotoSans-Bold.ttf:text='An alert you can actually notice.':fontsize=50:fontcolor=0xf5f0e8:x=90:y=185:enable='between(t,6,10)',
drawtext=fontfile=/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf:text='The Play alert catches your eye.':fontsize=27:fontcolor=0xc8c0b8:x=90:y=275:enable='between(t,6,10)',
drawtext=fontfile=/usr/share/fonts/truetype/noto/NotoSans-Bold.ttf:text='One click takes you back.':fontsize=55:fontcolor=0xf5f0e8:x=90:y=185:enable='between(t,10,14)',
drawtext=fontfile=/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf:text='No window or tab hunting.':fontsize=28:fontcolor=0xc8c0b8:x=90:y=275:enable='between(t,10,14)',
drawtext=fontfile=/usr/share/fonts/truetype/noto/NotoSans-Bold.ttf:text='Stay in the game.':fontsize=59:fontcolor=0xf5f0e8:x=90:y=180:enable='between(t,14,18)',
drawtext=fontfile=/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf:text='A turn alert stays in sight while you browse.':fontsize=27:fontcolor=0xc8c0b8:x=90:y=275:enable='between(t,14,18)',
drawtext=fontfile=/usr/share/fonts/truetype/noto/NotoSans-Bold.ttf:text='Click the panel title.':fontsize=55:fontcolor=0xf5f0e8:x=90:y=180:enable='between(t,18,19.2)',
drawtext=fontfile=/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf:text='BGA comes back to you.':fontsize=28:fontcolor=0xc8c0b8:x=90:y=275:enable='between(t,18,19.2)',
drawtext=fontfile=/usr/share/fonts/truetype/noto/NotoSans-Bold.ttf:text='indri.studio/apps/bga-title-tray':fontsize=30:fontcolor=0xb8ef00:x=90:y=565:enable='between(t,14,19.2)',
drawtext=fontfile=/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf:text='Independent companion for Board Game Arena':fontsize=20:fontcolor=0x9f9991:x=90:y=670[base];
