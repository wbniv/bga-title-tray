drawtext=fontfile=/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf:text='Searching for 3 player(s)... • Board Game Arena':fontsize=22:fontcolor=white:x=195:y=416:enable='between(t,3,3.75)',
